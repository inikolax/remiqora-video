{
  "schema": 1,
  "_comment": "What a clean install downloads: the tools (pinned, sha256 from the GitHub release digest or computed once) and the model sets. Only official weights: the authors' repositories or Comfy-Org's ComfyUI repacks of them. Uncensored weights are never here; the user puts them in and picks them on the Models page. The sets' bytes and sha256 come from the Hugging Face API: python tools/make_manifest.py fills them in.",
  "requirements": {
    "minDriver": 580,
    "minComputeCapability": 7.5,
    "minVramMiB": 15000,
    "minFreeBytes": 70000000000
  },
